{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "2048-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web:clear",
        "--workspace",
        "@2048/game"
      ],
      "port": 8081
    },
    {
      "name": "2048-web-prod",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "apps/game/dist"
      ],
      "port": 8090
    },
    {
      "//": "Serves this repo's own build/ with vercel.json rewrites applied, which is exactly how Vercel will serve it. Run `npm run build` first.",
      "name": "2048-deploy-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/serve-local.py"
      ],
      "port": 8096
    }
  ]
}
