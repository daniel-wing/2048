# Supply-chain hardening.
#
# min-release-age delays resolving newly published versions (in days). Nearly
# every recent npm compromise was published, detected, and yanked within hours,
# so a one-day cooldown dodges that window entirely. Requires npm >= 11.10.
min-release-age=1

# Fail loudly rather than silently downgrading integrity guarantees.
audit=true
fund=false
